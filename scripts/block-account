#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/api.sh"

require_tools

if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage "$(basename "$0") <credit-account-id> [reason]"
fi

account_id="$1"
body="{}"
if [[ $# -eq 2 ]]; then
  body="$(jq -cn --arg reason "$2" '{reason: $reason}')"
fi

api_post "/credit-accounts/${account_id}/block" "$body"
